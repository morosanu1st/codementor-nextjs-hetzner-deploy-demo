[Unit]
Description=Next.js App (standalone)
After=network.target

[Service]
Type=simple
User=www-data
WorkingDirectory=/var/www/nextjs-app
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=HOSTNAME=127.0.0.1
ExecStart=/usr/bin/node /var/www/nextjs-app/.next/standalone/server.js
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
